# LLM provider: gemini (Google AI Studio, default), openai-compatible
# (OpenRouter/Groq/APInex/...) or bedrock (AWS Bedrock Converse). Only one path
# is used, selected by LLM_PROVIDER.
LLM_PROVIDER=gemini
# packages/core + apps/api (gemini path)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# openai-compatible path (used when LLM_PROVIDER=openai-compatible)
# OPENAI_COMPATIBLE_BASE_URL=https://api.apinex.bond/v1
# OPENAI_COMPATIBLE_API_KEY=
# LLM_MODEL=free/gemini-3.8-flash
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
# You.com REST search (SEARCH_PROVIDER=you). NOTE: the free tier is MCP-only
# (api.you.com/mcp?profile=free, ~100 queries/day); REST needs a paid key.
# YOU_API_KEY=
# bedrock path (used when LLM_PROVIDER=bedrock). Credentials resolve from AWS_*
# env vars when set (deploy), otherwise via `aws configure export-credentials`
# (SSO dev login on this machine). Bedrock is paid per-token (no free tier).
# BEDROCK_MODEL=zai.glm-5
# BEDROCK_REGION=ap-south-1
# apps/api
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/prepkit
SESSION_SECRET=change-me
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development
# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000
# batch pacing (free-tier requests per minute)
PREP_RPM=12
