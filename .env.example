# LLM provider: gemini (Google AI Studio, default) or openai-compatible
# (OpenRouter/Groq/APInex/...). Only one path is used, selected by LLM_PROVIDER.
LLM_PROVIDER=gemini
# packages/core + apps/api (gemini path)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# openai-compatible path (used when LLM_PROVIDER=openai-compatible)
# OPENAI_COMPATIBLE_BASE_URL=https://api.apinex.bond/v1
# OPENAI_COMPATIBLE_API_KEY=
# LLM_MODEL=free/gemini-3.8-flash
BRAVE_API_KEY=
# apps/api
MONGODB_URI=mongodb://127.0.0.1:27017/prepkit
SESSION_SECRET=change-me
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000
# batch pacing (free-tier requests per minute)
PREP_RPM=12
